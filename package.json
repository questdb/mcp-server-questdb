{
  "name": "@questdb/mcp-server-questdb",
  "version": "0.5.0",
  "mcpName": "io.github.questdb/mcp-server-questdb",
  "description": "QuestDB MCP server that exposes the QuestDB Web Console notebook to coding agents (Claude Code, Codex) over a local WebSocket.",
  "license": "Apache-2.0",
  "author": "QuestDB",
  "homepage": "https://github.com/questdb/mcp-server-questdb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/questdb/mcp-server-questdb.git"
  },
  "bugs": {
    "url": "https://github.com/questdb/mcp-server-questdb/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "questdb",
    "claude",
    "codex",
    "model-context-protocol",
    "time-series",
    "notebook",
    "sql"
  ],
  "type": "module",
  "bin": "./dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && cp -R src/consts/. dist/consts/ && test -f dist/consts/shared-definitions.json && test -f dist/consts/agent-installs.json && chmod +x dist/index.js",
    "bundle": "node src/scripts/bundle.js",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync-tools": "node src/scripts/sync-tools.js",
    "prepublishOnly": "yarn lint && yarn typecheck && yarn build && yarn test"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.9.1",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "~1.32.2",
    "jsonc-parser": "^3.3.1",
    "open": "^11.0.0",
    "ws": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@inquirer/testing": "^3.3.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "resolutions": {
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "qs": "^6.17.1",
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.3",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.6",
    "brace-expansion": "^5.0.13",
    "minimatch@npm:^10.2.2": "^11.0.9",
    "minimatch@npm:^10.2.4": "^11.0.9",
    "tar": "^7.5.23",
    "glob": "^14.0.6",
    "undici@npm:^6.25.0": "^6.29.1"
  }
}
